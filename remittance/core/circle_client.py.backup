"""Circle API Client - Direct integration without broken package"""
import os
import httpx
import json
import logging
from typing import Dict, Optional, List
from datetime import datetime

logger = logging.getLogger("circle-client")

class CircleClient:
    """Direct Circle API client (no broken dependencies)"""
    
    def __init__(self, api_key: str = None):
        self.api_key = api_key or os.getenv("CIRCLE_API_KEY")
        self.base_url = "https://api.circle.com/v1"
        self.client = httpx.AsyncClient(timeout=30.0)
        
