FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    redis \
    httpx \
    mt5linux \
    pandas

COPY api_bridge.py .

EXPOSE 8002

CMD ["uvicorn", "api_bridge:app", "--host", "0.0.0.0", "--port", "8002", "--reload"]
